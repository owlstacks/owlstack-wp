{
    "name": "owlstack/owlstack-wordpress",
    "description": "WordPress plugin for Owlstack — publish content to Telegram, X (Twitter), and Facebook from your WordPress site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "owlstack",
        "social-media",
        "telegram",
        "twitter",
        "x",
        "facebook",
        "content-syndication",
        "publishing"
    ],
    "authors": [
        {
            "name": "Ali Hesari",
            "email": "ali@alihesari.com",
            "homepage": "https://owlstack.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "owlstack/owlstack-core": "^1.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpunit/phpunit": "^10.0|^11.0",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Owlstack\\WordPress\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Owlstack\\WordPress\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
